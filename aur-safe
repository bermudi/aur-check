  _class_bld "$_clx" cls-removed-opener-latch \
    "$_old_dup_dep_pkg" "$_new_inline_stray_dep_pkg" "$_old_dep_src" "$_new_repo_dep_src"
  if _pkgbuild_repo_dep_added_line "$_CLASS_DIR" "$_CLASS_BASE" "  'alsa-lib'"; then
    log "  $(c_red "FAIL") classifier-removed-opener-cannot-latch"; fail=$((fail+1))
  else
    log "  $(c_green "PASS") classifier-removed-opener-cannot-latch"; pass=$((pass+1))
  fi

  # PKGBUILD build-var assigned a bare git SHA (_commit=<hex>, optionally
  # quoted). Inert: the RHS of a string assignment is never executed; it just
  # selects which same-host path source=() fetches, verified by the *sums=()
  # array. The cursor-bin shape. Three variants: unquoted, single, double.
  printf -v _commit_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\n_commit=%s\nsource=("https://example.com/${_commit}/pkg.tar")\nsha256sums=(%s)' \
    "4aa8ff1b7877ed7bd01bcba308698f71a6735380" "$_sum1"
  printf -v _commit_new_pkg_unq 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\n_commit=%s\nsource=("https://example.com/${_commit}/pkg.tar")\nsha256sums=(%s)' \
    "042b3c1a4c53f2c3808067f519fbfc67b72cad8b" "$_sum1"
  printf -v _commit_new_pkg_sq "pkgname=cls-pkg\npkgver=2.0\npkgrel=1\n_commit='%s'\nsource=(\"https://example.com/\${_commit}/pkg.tar\")\nsha256sums=(%s)" \
    "042b3c1a4c53f2c3808067f519fbfc67b72cad8b" "$_sum1"
  printf -v _commit_new_pkg_dq 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\n_commit="%s"\nsource=("https://example.com/${_commit}/pkg.tar")\nsha256sums=(%s)' \
    "042b3c1a4c53f2c3808067f519fbfc67b72cad8b" "$_sum1"
  _commit_old_src=$'pkgbase = cls-pkg\n\tpkgver = 1.0\n\tpkgrel = 1\n\tsource = https://example.com/4aa8ff1b7877ed7bd01bcba308698f71a6735380/pkg.tar\n\tsha256sums = '"$_sum1"$'\n\npkgname = cls-pkg'
  _commit_new_src=$'pkgbase = cls-pkg\n\tpkgver = 2.0\n\tpkgrel = 1\n\tsource = https://example.com/042b3c1a4c53f2c3808067f519fbfc67b72cad8b/pkg.tar\n\tsha256sums = '"$_sum1"$'\n\npkgname = cls-pkg'
  tc_class pkgbuild-commit-var-unquoted boring 0 \
    "$_commit_old_pkg" "$_commit_new_pkg_unq" "$_commit_old_src" "$_commit_new_src"
  tc_class pkgbuild-commit-var-single-quoted boring 0 \
    "$_commit_old_pkg" "$_commit_new_pkg_sq" "$_commit_old_src" "$_commit_new_src"
  tc_class pkgbuild-commit-var-double-quoted boring 0 \
    "$_commit_old_pkg" "$_commit_new_pkg_dq" "$_commit_old_src" "$_commit_new_src"

  # PKGBUILD build-var assigned a dotted-decimal version (the opera-developer
  # shape: _nwjs_ffmpeg_version=0.113.0). Inert for the same reason _commit=<hex>
  # is: the RHS of a string assignment never executes, and the version only
  # selects a path in source=() whose artifact is verified by *sums=(). The
  # var-name is NOT restricted here (unlike _commit): a dotted decimal cannot be
  # a PGP fingerprint (hex) or checksum (hex/SKIP), so the RHS format is the
  # security boundary. Two variants: plain decimal (0.113.0) and 'v'-prefixed
  # (v25.3.0). The motivating package var is _nwjs_ffmpeg_version, not _version
  # — a name allowlist would miss it.
  printf -v _ver_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\n_nwjs_ffmpeg_version=0.112.0\nsource=("https://example.com/${_nwjs_ffmpeg_version}/ffmpeg.zip")\nsha256sums=(%s)' "$_sum1"
  printf -v _ver_new_pkg_dec 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\n_nwjs_ffmpeg_version=0.113.0\nsource=("https://example.com/${_nwjs_ffmpeg_version}/ffmpeg.zip")\nsha256sums=(%s)' "$_sum1"
  printf -v _ver_new_pkg_vpref 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\n_electron_version=v25.3.0\nsource=("https://example.com/${_electron_version}/electron.zip")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgbuild-version-var-decimal boring 0 \
    "$_ver_old_pkg" "$_ver_new_pkg_dec" "$_commit_old_src" "$_commit_new_src"
  tc_class pkgbuild-version-var-vprefixed boring 0 \
    "$_ver_old_pkg" "$_ver_new_pkg_vpref" "$_commit_old_src" "$_commit_new_src"

  # Regression: a version-looking build-var RHS that is command substitution
  # must NOT clear — the $ breaks the dotted-decimal match (same rejection path
  # as the _commit command-subst regression below). Payload-free substitution
  # isolates the classifier question; a real payload hits hard rules first.
  printf -v _ver_subst_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\n_version=$(echo 1.2.3)\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgbuild-version-var-command-subst-review review 2 \
    "$_ver_old_pkg" "$_ver_subst_pkg" "$_commit_old_src" "$_commit_new_src"

  # Regression: a build-var RHS that is command substitution (not a bare hex
  # SHA) must NOT clear via the _commit rule — it executes at source time. Use a
  # payload-free substitution so the hard-rule pipeline doesn't fire first; this
  # isolates the classifier question (regex must reject `$`/non-hex RHS). Note:
  # a real malicious payload (curl|sh etc.) is caught earlier by the hard rules
  # as rc=1 hard-block, which is even stronger — this test exercises the
  # classifier's own rejection path.
  printf -v _commit_subst_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\n_commit=$(date)\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgbuild-commit-var-command-subst-review review 2 \
    "$_commit_old_pkg" "$_commit_subst_pkg" "$_commit_old_src" "$_commit_new_src"

  # Regression (delegate-review Finding 1): a NON-conventional _var assigned a
  # lowercase 40-hex value must NOT clear via the _commit rule — even though
  # such a value is a valid PGP fingerprint. This closes the validpgpkeys-
  # indirection gap: with an unchanged validpgpkeys=($_evil) already present, a
  # newly-added _evil=<lowercase-40hex> would change the trust anchor, so it
  # must reach review. The rule's var-name allowlist (_commit/_gittag/_gitrev/
  # _tag/_rev) is what closes the gap — _evil is not in it. (Lowercase is NOT
  # a defense; validpgpkeys= accepts any case. The var-name restriction is.)
  _commit_evil_pkg=$'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nvalidpgpkeys=($_evil)\n_evil=0123456789abcdef0123456789abcdef01234567\nsource=("https://example.com/pkg.tar")\nsha256sums='"($_sum1)"
  tc_class pkgbuild-commit-var-arbitrary-name-review review 2 \
    "$_commit_old_pkg" "$_commit_evil_pkg" "$_commit_old_src" "$_commit_new_src"

  # Symmetric positive control for the version-var rule: mirrors the _evil hex
  # regression above, but with validpgpkeys=($_evil) UNCHANGED across baseline
  # and new, so the sole diff line is _evil=<value>. (The hex test above adds
  # validpgpkeys=() itself, so its review result is overdetermined — it can't
  # isolate the _evil line.) With a dotted-decimal RHS, _evil=1.2.3 cannot be a
  # PGP fingerprint (gpg rejects it loudly → build breaks, not silent anchor
  # advance) and cannot be a checksum, so clearing it is safe even with the
  # validpgpkeys indirection present: the RHS format is the boundary, not the
  # var name. This documents-by-test the contrast with the hex shape (review).
  printf -v _ver_evil_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nvalidpgpkeys=($_evil)\n_evil=0.0.0\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s)' "$_sum1"
  _ver_evil_pkg=$'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nvalidpgpkeys=($_evil)\n_evil=1.2.3\nsource=("https://example.com/pkg.tar")\nsha256sums='"($_sum1)"
  tc_class pkgbuild-version-var-fingerprint-shape-boring boring 0 \
    "$_ver_evil_old_pkg" "$_ver_evil_pkg" "$_commit_old_src" "$_commit_new_src"

  # Regression (exec-subst bypass): the permissive scalar/array-literal
  # matchers above (pkgver=, license=/arch=/…=(…), source=(…), *sums=(…))
  # must NOT auto-clear a line carrying command substitution / backtick /
  # process subst — it EXECUTES when makepkg sources the PKGBUILD, before any
  # *sums check. The _exec_subst_in_line guard backs all of them. Payload-free
  # substitutions isolate the classifier's own rejection path; a real
  # curl|sh-style payload is also caught earlier as rc=1 hard (pipe-to-
  # interpreter), which is even stronger.
  printf -v _subst_sums 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=($(evil_sums))'
  printf -v _subst_source 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=($(evil_source))\nsha256sums=(%s)' "$_sum1"
  printf -v _subst_license 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nlicense=($(evil_license))\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _subst_pkgver 'pkgname=cls-pkg\npkgver=$(evil_pkgver)\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _subst_pkgrel 'pkgname=cls-pkg\npkgver=1.0\npkgrel=$(evil_pkgrel)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _subst_backtick 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(`evil_bt`)'
  tc_class exec-subst-sums-array-review review 2 \
    "$_old_basic" "$_subst_sums" "$_old_src" "$_old_src"
  tc_class exec-subst-source-array-review review 2 \
    "$_old_basic" "$_subst_source" "$_old_src" "$_old_src"
  tc_class exec-subst-license-array-review review 2 \
    "$_old_basic" "$_subst_license" "$_old_src" "$_old_src"
  tc_class exec-subst-pkgver-review review 2 \
    "$_old_basic" "$_subst_pkgver" "$_old_src" "$_old_src"
  tc_class exec-subst-pkgrel-review review 2 \
    "$_old_basic" "$_subst_pkgrel" "$_old_src" "$_old_src"
  tc_class exec-subst-backtick-sums-review review 2 \
    "$_old_basic" "$_subst_backtick" "$_old_src" "$_old_src"
  # Early array close + trailing text: bash runs the token after the INNER `)`
  # at source time (sha256sums=(hex)evil) runs evil). Deterministic review, not
  # boring_edge — the [^)]* array-literal matchers reject it, and the top-level
  # early-close guard sends any `)`-followed-by-text line to review so the LLM
  # auto-green path can never clear a code-exec shape.
  printf -v _subst_sums_close 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(508512464e24126fddfb2c41a1e2e86624bdb0c0748084b6a922573b6cf6b9c5)evil_cmd)'
  tc_class early-close-sums-then-cmd-review review 2 \
    "$_old_basic" "$_subst_sums_close" "$_old_src" "$_old_src"

  # Operator-chaining after a scalar value: pkgver=/pkgrel=/epoch= are now
  # EOL-anchored to a single version token, so `pkgver=2.0; evil_cmd` (and
  # `&&`/`|`/`&` variants) cannot clear — the separator chains a command at
  # source time. Array-literal matchers are already EOL-anchored after `)`, so
  # only the scalar rule needed this. Positive control below pins that the
  # tighter char class still clears real version shapes.
  printf -v _subst_pkgver_semi 'pkgname=cls-pkg\npkgver=2.0; evil_cmd\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _subst_pkgver_pipe 'pkgname=cls-pkg\npkgver=2.0 | evil_cmd\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class exec-subst-pkgver-semicolon-review review 2 \
    "$_old_basic" "$_subst_pkgver_semi" "$_old_src" "$_old_src"
  tc_class exec-subst-pkgver-pipe-review review 2 \
    "$_old_basic" "$_subst_pkgver_pipe" "$_old_src" "$_old_src"
  printf -v _pkgver_git 'pkgname=cls-pkg\npkgver=r1234.abc1234\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _pkgver_dfsg 'pkgname=cls-pkg\npkgver=1.0+dfsg1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgver-git-style-boring boring 0 \
    "$_old_basic" "$_pkgver_git" "$_old_src" "$_old_src"
  tc_class pkgver-suffix-style-boring boring 0 \
    "$_old_basic" "$_pkgver_dfsg" "$_old_src" "$_old_src"

  # File-aware/positive-grammar regressions for the source-time execution
  # bypass. None of these payload markers is executed by selftest: fixtures are
  # committed as bytes and inspected only by git/awk/grep.
  local _alt_subst_pkg _proc_subst_pkg _early_space_pkg _multiquote_old_pkg _multiquote_new_pkg
  local _srcinfo_shape_pkg _dep_shape_pkg _ws_collision_old_src _ws_collision_new_src
  local _param_old_pkg _param_new_pkg _legacy_old_pkg _legacy_new_pkg
  local _simple_source_old_pkg _simple_source_new_pkg _simple_source_old_src _simple_source_new_src
  local _herestring_old_pkg _herestring_new_pkg
  printf -v _alt_subst_pkg 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\nsource=("https://example.com/pkg.tar")\nsha256sums=(${ printf ALT_MARKER >&2; })'
  tc_class bash53-alternate-substitution-review review 2 \
    "$_old_basic" "$_alt_subst_pkg" "$_old_src" "$_old_src"
  printf -v _proc_subst_pkg 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\nsource=(<(printf PROC_MARKER))\nsha256sums=(%s)' "$_sum1"
  tc_class process-substitution-source-review review 2 \
    "$_old_basic" "$_proc_subst_pkg" "$_old_src" "$_old_src"
  printf -v _early_space_pkg 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s) printf EARLY_MARKER >&2 # )' "$_sum1"
  tc_class early-close-whitespace-command-review review 2 \
    "$_old_basic" "$_early_space_pkg" "$_old_src" "$_old_src"

  # The added line looks like a comment in isolation but is inside an unchanged
  # multiline double quote in the candidate; command substitution would run.
  _multiquote_old_pkg="$_old_basic"$'\n_desc="\nold text\n"'
  _multiquote_new_pkg="$_old_basic"$'\n_desc="\n#$(printf QUOTE_MARKER >&2)\nold text\n"'
  tc_class multiline-quote-comment-review review 2 \
    "$_multiquote_old_pkg" "$_multiquote_new_pkg" "$_old_src" "$_old_src"

  # .SRCINFO-shaped text in PKGBUILD is executable shell, never metadata. The
  # dependency case also proves the .SRCINFO helper cannot run before PKGBUILD
  # lexical/grammar classification now that paths are separated.
  _srcinfo_shape_pkg="$_old_basic"$'\nsource = x || printf SRCINFO_MARKER >&2'
  tc_class pkgbuild-srcinfo-shape-review review 2 \
    "$_old_basic" "$_srcinfo_shape_pkg" "$_old_src" "$_old_src"
  _dep_shape_pkg="$_old_basic"$'\ndepends = alsa-lib $(printf DEP_MARKER >&2)'
  tc_class pkgbuild-srcinfo-dependency-shape-review review 2 \
    "$_old_basic" "$_dep_shape_pkg" "$_old_src" "$_old_src"
  _ws_collision_old_src="$_old_src"$'\n  printf WS_MARKER >&2'
  _ws_collision_new_src="$_old_src"$'\nprintf WS_MARKER >&2'
  tc_class srcinfo-whitespace-cannot-mask-pkgbuild review 2 \
    "$_old_basic" "$_old_basic"$'\nprintf WS_MARKER >&2' \
    "$_ws_collision_old_src" "$_ws_collision_new_src"

  # Parameter prompt expansion and legacy arithmetic can recursively evaluate
  # attacker-controlled baseline strings. Only simple $name/${name} source
  # expansion is in the positive grammar.
  _param_old_pkg="$_old_basic"$'\n_p=\'$(printf PARAM_MARKER >&2)\''
  _param_new_pkg="$_param_old_pkg"$'\nsource=("${_p@P}")'
  tc_class parameter-prompt-expansion-review review 2 \
    "$_param_old_pkg" "$_param_new_pkg" "$_old_src" "$_old_src"
  _legacy_old_pkg="$_old_basic"$'\n_p=\'a[$(printf LEGACY_MARKER >&2)]\''
  _legacy_new_pkg="$_legacy_old_pkg"$'\nsource=($[_p])'
  tc_class legacy-arithmetic-expansion-review review 2 \
    "$_legacy_old_pkg" "$_legacy_new_pkg" "$_old_src" "$_old_src"

  # Positive controls: balanced scalar quotes/comments, quoted literal `)` and
  # ordinary source variable expansion remain deterministic metadata.
  tc_class pkgver-quoted-comment-boring boring 0 \
    "$_old_basic" "${_old_basic/pkgver=1.0/pkgver=\"2.0\" # upstream}" \
    "$_old_src" "$_new_src"
  tc_class advisory-quoted-paren-boring boring 0 \
    "$_old_basic" "$_old_basic"$'\nlicense=(\'custom:foo)bar\')' \
    "$_old_src" "$_old_src"$'\n\tlicense = custom:foo)bar'
  printf -v _herestring_old_pkg 'pkgname=cls-pkg\n_note=$(cat <<< "trusted")\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _herestring_new_pkg 'pkgname=cls-pkg\n_note=$(cat <<< "trusted")\npkgver=2.0\npkgrel=1\nsource=("https://example.com/pkg.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class prior-herestring-does-not-poison-context boring 0 \
    "$_herestring_old_pkg" "$_herestring_new_pkg" "$_old_src" "$_new_src"
  printf -v _simple_source_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/${pkgver}/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _simple_source_new_pkg 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\nsource=("https://example.com/${pkgver}/pkg-2.tar")\nsha256sums=(%s)' "$_sum2"
  _simple_source_old_src=$'pkgbase = cls-pkg\n\tpkgver = 1.0\n\tpkgrel = 1\n\tsource = https://example.com/1.0/pkg-1.tar\n\tsha256sums = '"$_sum1"$'\n\npkgname = cls-pkg'
  _simple_source_new_src=$'pkgbase = cls-pkg\n\tpkgver = 2.0\n\tpkgrel = 1\n\tsource = https://example.com/2.0/pkg-2.tar\n\tsha256sums = '"$_sum2"$'\n\npkgname = cls-pkg'
  tc_class source-simple-variable-boring boring 0 \
    "$_simple_source_old_pkg" "$_simple_source_new_pkg" \
    "$_simple_source_old_src" "$_simple_source_new_src"

  # noextract= is .SRCINFO metadata (a versioned *filename*, runs no code) —
  # an added/changed line must not force review. Append to an otherwise
  # unchanged .SRCINFO so the only diff is the noextract line.
  tc_class srcinfo-noextract-boring boring 0 \
    "$_old_basic" \
    "$_old_basic" \
    "$_old_src" \
    "$_old_src"$'\n\tnoextract = foo-1.0.deb'

  # Real cursor-bin shape: version bump renames the noextract= filename AND the
  # source= URL (same host) AND the sha512sum. noextract + source + checksum
  # must all clear as boring.
  printf -v _noextract_old_pkgbuild 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/foo-1.0.deb")\nsha256sums=(%s)' "$_sum1"
  printf -v _noextract_new_pkgbuild 'pkgname=cls-pkg\npkgver=2.0\npkgrel=1\nsource=("https://example.com/foo-2.0.deb")\nsha256sums=(%s)' "$_sum1"
  _noextract_old_src=$'pkgbase = cls-pkg\n\tpkgver = 1.0\n\tpkgrel = 1\n\tnoextract = foo-1.0.deb\n\tsource = https://example.com/foo-1.0.deb\n\tsha256sums = '"$_sum1"$'\n\npkgname = cls-pkg'
  _noextract_new_src=$'pkgbase = cls-pkg\n\tpkgver = 2.0\n\tpkgrel = 1\n\tnoextract = foo-2.0.deb\n\tsource = https://example.com/foo-2.0.deb\n\tsha256sums = '"$_sum1"$'\n\npkgname = cls-pkg'

  tc_class srcinfo-noextract-version-rename boring 0 \
    "$_noextract_old_pkgbuild" \
    "$_noextract_new_pkgbuild" \
    "$_noextract_old_src" \
    "$_noextract_new_src"

  # Arch-qualified .SRCINFO source_<arch> = lines (the opencode-bin /
  # visual-studio-code-bin shape): a version bump renames the per-arch source
  # URL on the SAME host. PKGBUILD carries matching source_<arch>=(...) arrays.
  # Before the fix, the .SRCINFO source_x86_64 = / source_aarch64 = lines fell
  # through _boring_added_line_class to review (no matcher for the space-
  # delimited arch-qualified source form), producing a false-positive review on
  # an otherwise-identical version bump. Now symmetric with the arch-qualified
  # sha*sums_<arch> = form that already cleared.
  printf -v _archsrc_old_pkg 'pkgname=cls-pkg\npkgver=1.126.0\npkgrel=1\nsource_x86_64=("code_1.126.0_amd64.deb::https://update.code.visualstudio.com/1.126.0/linux-deb-x64/stable")\nsource_aarch64=("code_1.126.0_arm64.deb::https://update.code.visualstudio.com/1.126.0/linux-deb-arm64/stable")\nsha256sums_x86_64=(%s)\nsha256sums_aarch64=(%s)' "$_sum1" "$_sum1"
  printf -v _archsrc_new_pkg 'pkgname=cls-pkg\npkgver=1.127.0\npkgrel=1\nsource_x86_64=("code_1.127.0_amd64.deb::https://update.code.visualstudio.com/1.127.0/linux-deb-x64/stable")\nsource_aarch64=("code_1.127.0_arm64.deb::https://update.code.visualstudio.com/1.127.0/linux-deb-arm64/stable")\nsha256sums_x86_64=(%s)\nsha256sums_aarch64=(%s)' "$_sum2" "$_sum2"
  _archsrc_old_src=$'pkgbase = cls-pkg\n\tpkgver = 1.126.0\n\tpkgrel = 1\n\tsource_x86_64 = code_1.126.0_amd64.deb::https://update.code.visualstudio.com/1.126.0/linux-deb-x64/stable\n\tsource_aarch64 = code_1.126.0_arm64.deb::https://update.code.visualstudio.com/1.126.0/linux-deb-arm64/stable\n\tsha256sums_x86_64 = '"$_sum1"$'\n\tsha256sums_aarch64 = '"$_sum1"$'\n\npkgname = cls-pkg'
